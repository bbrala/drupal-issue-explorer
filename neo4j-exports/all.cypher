:begin
CREATE FULLTEXT INDEX node_titles FOR (n:Issue) ON EACH [n.`title`,n.`nid`];
CREATE RANGE INDEX FOR (n:Issue) ON (n.changed);
CREATE RANGE INDEX FOR (n:Issue) ON (n.created);
CREATE RANGE INDEX FOR (n:Issue) ON (n.field_issue_parent);
CREATE RANGE INDEX FOR (n:Issue) ON (n.field_issue_related);
CREATE RANGE INDEX FOR (n:Issue) ON (n.field_issue_status);
CREATE RANGE INDEX FOR (n:Issue) ON (n.field_project);
CREATE CONSTRAINT constraint_10b066c5 FOR (node:Issue) REQUIRE (node.nid) IS UNIQUE;
:commit
CALL db.awaitIndexes(300);
